# Supabase — client-safe (exposed to the browser; the anon key is safe by design,
# all access control is enforced server-side via RLS policies)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers — server-only. Free-tier failover order:
#   Gemini -> Groq -> Together AI -> Hugging Face -> OpenRouter
#
# Each provider supports multi-key rotation to spread quota across multiple
# free-tier accounts. Add numbered keys (2..10) to rotate round-robin:
#   GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... GEMINI_API_KEY_10
#   OPENROUTER_API_KEY_2, OPENROUTER_API_KEY_3, ... OPENROUTER_API_KEY_10
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
TOGETHER_API_KEY=your-together-ai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Default LLM provider used by /api/ai/generate when "provider" is omitted
AI_DEFAULT_PROVIDER=gemini

# Content migration (scripts/migrate-content.mjs) — optional override
# MIGRATE_SOURCE_DIR=../ravikishan/migrated-content