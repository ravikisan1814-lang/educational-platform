# Supabase — client-safe (exposed to the browser; the anon key is safe by design,
# all access control is enforced server-side via RLS policies)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers — server-only
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key

# Default LLM provider used by /api/ai/generate when "provider" is omitted
AI_DEFAULT_PROVIDER=gemini
